{
  "name": "janine-lindenmann.de",
  "license": "MIT",
  "version": "25.09.14",
  "description": "Website of Janine Lindenmann",
  "author": "Markus Lindenmann <tiliavir@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tiliavir/janine-lindenmann.git"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "Firefox ESR",
    "ie 11"
  ],
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "8.0.0",
    "@typescript-eslint/eslint-plugin": "8.61.0",
    "autoprefixer": "10.5.0",
    "eslint": "10.4.1",
    "glob-all": "3.3.1",
    "postcss": "8.5.15",
    "postcss-cli": "11.0.1",
    "prettier": "3.8.3",
    "prettier-plugin-go-template": "0.0.15",
    "stylelint": "17.13.0",
    "stylelint-config-recommended-scss": "17.0.1",
    "vnu-jar": "26.5.29"
  },
  "scripts": {
    "lint": "stylelint 'assets/scss/**/*.scss' && npx eslint .",
    "build": "hugo build --minify -b https://www.janine-lindenmann.de && node purgecss.mjs public/",
    "postbuild": "npx vnu --skip-non-html --also-check-css --also-check-svg --filterpattern '.*view-transition.*|.*CSS: Parse Error.*' public && echo \"\\033[33m[WARN] Validation is skipping some rules - check if still required, or if view-transitions are finally stable.\\033[0m\"",
    "postinstall": "npm run lint"
  }
}
