{
  "name": "janine-lindenmann.de",
  "license": "MIT",
  "version": "25.09.14",
  "description": "Website of Janine Lindenmann",
  "author": "Markus Lindenmann <tiliavir@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tiliavir/janine-lindenmann.git"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "Firefox ESR",
    "ie 11"
  ],
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "7.0.2",
    "@typescript-eslint/eslint-plugin": "8.53.0",
    "autoprefixer": "10.4.23",
    "eslint": "9.39.2",
    "glob-all": "3.3.1",
    "postcss": "8.5.6",
    "postcss-cli": "11.0.1",
    "prettier": "3.7.4",
    "prettier-plugin-go-template": "0.0.15",
    "stylelint": "16.26.1",
    "stylelint-config-recommended-scss": "16.0.2",
    "vnu-jar": "26.1.11"
  },
  "scripts": {
    "lint": "stylelint 'assets/scss/**/*.scss' && npx eslint .",
    "build": "hugo build --minify -b https://www.janine-lindenmann.de && node purgecss.mjs public/",
    "postbuild": "npx vnu --skip-non-html --also-check-css --also-check-svg public",
    "postinstall": "npm run lint"
  }
}
